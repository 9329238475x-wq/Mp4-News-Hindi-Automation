# ==============================================================================
# NEWS AUTOMATION - API KEYS TEMPLATE (.env.example)
# ==============================================================================
# इस फाइल की कॉपी बनाकर .env नाम रखें और अपनी keys भरें।

# 1. स्टॉक वीडियो और फोटोज़ (Pexels, Pixabay, Unsplash)
# https://www.pexels.com/api/
PEXELS_API_KEY=
# https://pixabay.com/api/docs/
PIXABAY_API_KEY=
# https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# 2. ताज़ा खबरें (NewsAPI, GNews)
# https://newsapi.org/register
NEWS_API_KEY=
# https://gnews.io/
GNEWS_API_KEY=

# 3. मीम्स और GIFs (Giphy, Tenor)
# https://developers.giphy.com/
GIPHY_API_KEY=
# https://developers.google.com/tenor/guides/quickstart
TENOR_API_KEY=

# 4. साउंड इफेक्ट्स (Freesound)
# https://freesound.org/help/developers/
FREESOUND_API_KEY=

# 5. वॉइसओवर (वैकल्पिक)
# https://elevenlabs.io/
ELEVENLABS_API_KEY=
